# POPCIX Client Environment Configuration
# Copy this file to .env or set variables in your hosting / CI environment

# Supabase Auth & Database (Official Project API credentials)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# App metadata
EXPO_PUBLIC_APP_NAME=POPCIX
EXPO_PUBLIC_APP_ENV=production

# Server-Side Rate Limiting (Redis / Upstash for POPCIX-owned endpoints)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
